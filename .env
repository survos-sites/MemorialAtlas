# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://postgres:docker@127.0.0.1:5434/scanfony?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/ai-generic-platform ###
# GENERIC_BASE_URL=https://api.example.com/v1
###< symfony/ai-generic-platform ###

###> symfony/ai-mistral-platform ###
MISTRAL_API_KEY=
###< symfony/ai-mistral-platform ###

###> symfony/ai-open-ai-platform ###
OPENAI_API_KEY=
###< symfony/ai-open-ai-platform ###

# Optional synchronous publishing and AI processing. Credentials go in .env.local.
S3_ENDPOINT=
AWS_S3_BUCKET_NAME=
AWS_S3_ACCESS_ID=
AWS_S3_ACCESS_SECRET=
IMAGOR_HOST=
IMAGOR_SECRET=
SCANFONY_VISION_MODEL=mistral-medium-latest
OLLAMA_ENDPOINT=http://127.0.0.1:11434
SCANFONY_VISION_PLATFORM=mistral
SCANFONY_OCR_MODEL=mistral-ocr-latest
SCANFONY_OCR_ENABLED=1
HF_TOKEN=

# Hosted typed decisions, with optional experimental image escalation.
TYPESAFE_API_KEY=
SCANFONY_JEV_MODEL=jev-1.14.0
SCANFONY_META_OCR=0
# Set 1 for flowers, veteran accessories, clothing, and other visual context.
SCANFONY_REQUIRE_VISUAL_CONTEXT=0

# Admin username: admin. Set a password hash in .env.local; empty disables sign-in.
ADMIN_PASSWORD_HASH=

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

ELASTICSEARCH_DSN=elasticsearch://127.0.0.1:9200

SEARCH_INDEX_PREFIX=stonereader

# Mistral-compatible local OCR; change the base URL when the service is deployed.
MISTRAL_RUSTO_BASE_URL=https://mistral-rusto.survos.com
MISTRAL_RUSTO_API_KEY=
# Leave blank for the current OCR-only server. Set only when chat is supported.
MISTRAL_RUSTO_CHAT_MODEL=
# Hosted OCR remains the default. For local OCR: mistral_rusto + tiny (or small).
SCANFONY_OCR_PLATFORM=mistral
SCANFONY_EXTRACTION_PLATFORM=mistral
SCANFONY_EXTRACTION_MODEL=mistral-medium-latest
SCANFONY_VISION_ENABLED=1

RUSTO_OCR_URL=https://mistral-rusto.survos.com

# Public saved demo: no S3, Hugging Face or AI credentials needed.
DEMO_MANIFEST_URL=https://huggingface.co/datasets/museado/memorialatlas-demo/resolve/55a3cf7b60f179bbfce2426e85dff22ab77b5682/manifest.json

###> symfony/ux-imagor-image ###
# Stock local Imagor for dev/test; production uses the signed UX_IMAGE_DSN.
LOCAL_IMAGOR_DSN="imagor://127.0.0.1:8088?secure=false"
# Options available at https://github.com/symfony/ux/blob/3.x/src/Image/src/Bridge/Imagor/README.md
#
UX_IMAGE_DSN="imagor://127.0.0.1:8088?secure=false"
###< symfony/ux-imagor-image ###

###> symfony/messenger ###
# Processing and failed queues share the application database.
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###
