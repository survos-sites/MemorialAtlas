{% extends 'base.html.twig' %}
{% block title %}Connect your assistant · MemorialAtlas{% endblock %}
{% block body %}
<section style="max-width:860px">
{% embed '@SurvosAiChat/mcp_connect.html.twig' with {
    name: serverName,
    endpoint: endpoint,
    server: 'memorialatlas',
    app_name: 'mematlas',
    checkout: 'MemorialAtlas',
    title: 'Connect your assistant',
    back: {url: path('chat'), label: 'Ask MemorialAtlas'},
    intro: 'Explore the collection from your own AI assistant. Search inscriptions, read proposed records, and follow links back to the photographs. No MemorialAtlas account is needed.',
    section_class: '',
    body_class: '',
    tool_descriptions: {
        collection_overview: 'Collection coverage and processing counts.',
        search_memorials: 'Search names, inscriptions, descriptions, and symbols.',
        find_memorials: 'Find records by meaning using semantic search.',
        get_memorial: 'Read one record, its proposed people, uncertainties, and photo links.',
        collection_digest: 'Read summaries across the processed collection.',
        list_records_to_review: 'List records marked for review. This does not mean human review has taken place.',
    },
    prompt: 'Use MemorialAtlas to find stones that mention military service. Read the matching records, link to the photographs, and distinguish carved words from AI interpretations.',
    footnotes: ['These are AI-generated readings, not verified burial records. The original photographs remain the evidence. A shared marker may name several people; a symbol does not necessarily describe every person named.'],
} %}
    {% block url_note %}
        <p>Use the public URL above for cloud assistants. They cannot reach a local <code>.wip</code> address on your computer.</p>
    {% endblock %}
    {% block local_note %}
        <p>The application must already be configured with access to its database and services. No application provider keys need to be copied into your assistant. Semantic lookup uses the application’s configured embedding provider.</p>
    {% endblock %}
{% endembed %}
</section>
{% endblock %}
