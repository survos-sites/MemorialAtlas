{% extends 'base.html.twig' %}

{% block title %}Ask · MemorialAtlas{% endblock %}

{% block body %}
<style>
.chat{max-width:880px;margin:0 auto}
.chat-log{display:flex;flex-direction:column;gap:18px;margin:24px 0}
.chat-q{align-self:flex-end;max-width:80%;background:#c99a3e;color:#1b1f1c;font-weight:600;padding:12px 18px;border-radius:18px 18px 4px 18px}
.chat-tools{display:flex;flex-wrap:wrap;gap:8px}
.chat-tool{font:600 .78rem ui-monospace,SFMono-Regular,Menlo,monospace;background:#e6e7de;border:1px solid #cfd2c5;border-radius:20px;padding:4px 12px;color:#3b463f}
.chat-tool b{color:#8a6a24}.chat-tool.failed{border-color:#c9a191;color:#8c4a33}
.chat-a{background:#fcfaf5;border:1px solid #d9d9cf;border-radius:18px 18px 18px 4px;padding:6px 22px}
.chat-a p,.chat-a li{line-height:1.6}
.chat-form{display:flex;gap:10px;position:sticky;bottom:0;background:#f3f0e9;padding:14px 0}
.chat-form input{flex:1;font:inherit;padding:13px 16px;border:1px solid #c9c9bd;border-radius:4px;background:#fff}
.chat-examples{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 0}
.chat-stones{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin:10px 0 0}.chat-stones a{display:block;color:inherit;text-decoration:none;font-size:.78rem;line-height:1.3}.chat-stones img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:4px;border:1px solid #d9d9cf;display:block;margin-bottom:4px}
.chat-a.streaming{white-space:pre-wrap;padding:16px 22px}.chat-a.streaming:empty::before{content:attr(data-status);color:#6c756a}.chat-plan{flex-basis:100%;margin:0;color:#6c756a;font-size:.85rem;font-style:italic}
.chat-examples button{background:#e1e8dd!important;color:#29362f!important;padding:8px 12px!important;font-size:.85rem;cursor:pointer}
</style>
<div class="chat">
<p><a href="{{ path('assistant_connect') }}">Connect your own assistant →</a></p>
    <p class="eyebrow muted">Ask the collection</p>
    <h1>Every stone tells a story</h1>
    <p>Ask about the people buried in St. Peter's Church Graveyard. The assistant looks up the records with the same tools that the MCP server offers to other AI agents, and links each record it uses. Every record is an AI reading of a photo, for a person to check.</p>

    <div data-controller="chat" data-chat-url-value="{{ path('chat_stream') }}">
    <div class="chat-log" data-chat-target="log">
        {% for turn in turns %}
            {{ include('chat/_turn.html.twig', {turn: turn, index: loop.index0}) }}
        {% endfor %}
    </div>

    <form class="chat-form" method="post" action="{{ path('chat_ask') }}" data-action="chat#ask">
        <input name="question" maxlength="500" required autofocus data-chat-target="input" placeholder="Tell me about the veterans buried here" aria-label="Your question">
        <button type="submit" data-chat-target="button">Ask</button>
    </form>
    {% if not turns %}
        <div class="chat-examples">
            {% for example in ['Tell me about the veterans buried here.', 'Who had hobbies or interests?', 'Which stones quote scripture, and from which books?', 'Which stones were photographed more than once?'] %}
                <button type="button" onclick="const q = document.querySelector('.chat-form input'); q.value = this.textContent; q.focus();">{{ example }}</button>
            {% endfor %}
        </div>
    {% else %}
        <form method="post" action="{{ path('chat_reset') }}"><button class="chat-examples" style="background:none!important;color:#6c756a!important;padding:0!important">Start over</button></form>
    {% endif %}
    </div>
</div>
{% endblock %}
