{% extends 'base.html.twig' %}
{% block title %}Drone spheres · MemorialAtlas{% endblock %}
{% block body %}
<style>.drone-frame{display:block;width:100%;height:calc(100vh - 230px);min-height:460px;border:0;border-radius:5px;background:#0e1214}</style>
<span class="eyebrow">Not part of the hackathon entry</span>
<p style="margin:8px 0 16px">St. Peter's churchyard from an Antigravity A1 drone, 13 November 2026. Drag to look around; the map places each sphere. Positions are estimates. <a href="{{ path('about') }}#drone">How we made these</a> · <a href="/drone/st-peter.html" id="drone-full">Full screen</a></p>
<iframe class="drone-frame" id="drone-frame" src="/drone/st-peter.html" title="360° sphere viewer with a map of sphere positions" allow="fullscreen" allowfullscreen></iframe>
<script>
  // /drone#5 opens sphere 5; the About map links here.
  if (/^#\d+$/.test(location.hash)) {
    document.getElementById('drone-frame').src = '/drone/st-peter.html' + location.hash;
    document.getElementById('drone-full').href = '/drone/st-peter.html' + location.hash;
  }
</script>
{% endblock %}
