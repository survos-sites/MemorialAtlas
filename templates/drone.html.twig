{% extends 'base.html.twig' %}
{% block title %}Drone spheres · MemorialAtlas{% endblock %}
{% block body %}
<style>.drone-frame{display:block;width:100%;height:calc(100vh - 230px);min-height:460px;border:0;border-radius:5px;background:#0e1214}</style>
<span class="eyebrow">Not part of the hackathon entry</span>
<p style="margin:8px 0 16px">St. Peter's churchyard from an Antigravity A1 drone, 13 November 2026. Drag to look around; the stitched overview places two photos and five video frames using image matches, not GPS. <a href="{{ path('about') }}#drone">How we made these</a> · <a href="/drone/row/" id="drone-full">Full screen</a></p>
<iframe class="drone-frame" id="drone-frame" src="/drone/row/" title="360° sphere viewer with a map of sphere positions" allow="fullscreen" allowfullscreen></iframe>
<section id="inscription-study" aria-labelledby="inscription-title">
<h2 id="inscription-title">A first inscription, still unverified</h2>
<figure style="margin:1rem 0">
<img src="/drone/row/stone-crop.jpg" alt="Straightened crop of the Carla Elizabeth headstone" width="700" height="700" style="width:100%;max-width:560px;height:auto">
<figcaption>Photo taken 13 November 2026 at 12:59:45. Cropped and perspective-corrected from the drone image; no generated detail.</figcaption>
</figure>
<p><strong>Tentative transcription, requires review</strong><br>
In Loving Memory<br>CARLA ELIZABETH<br>DI GIULIAN <em>(surname uncertain)</em><br>
<em>Dates and lower inscription not reliably transcribed.</em></p>
<p>The hosted OCR read the surname as <q>DI GIULAN</q>; visual review suggests <q>DI GIULIAN</q>. This reading is not a verified burial record.</p>
<p><a class="button" href="/drone/row/?photo=IMG_20261113_125945_240">Explore the source photo</a></p>
</section>

<script>
  // /drone#5 opens sphere 5; the About map links here.
  if (/^#\d+$/.test(location.hash)) {
    document.getElementById('drone-frame').src = '/drone/st-peter.html' + location.hash;
    document.getElementById('drone-full').href = '/drone/st-peter.html' + location.hash;
  }
</script>
{% endblock %}
