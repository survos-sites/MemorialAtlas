<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MemorialAtlas · St. Peter’s row explorer</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@photo-sphere-viewer/core@5.15.1/index.css">
<style>
:root{color-scheme:dark;font-family:system-ui,sans-serif;color:#e9eee9;background:#101814}*{box-sizing:border-box}body{margin:0}header{height:88px;padding:16px 24px;border-bottom:1px solid #344139;display:flex;align-items:center;justify-content:space-between;gap:20px}h1{font:500 25px Georgia,serif;margin:0 0 6px}.eyebrow{color:#a8bdad;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:5px}.subtitle{color:#aebbb1;font-size:13px}main{display:grid;grid-template-columns:42% 58%;height:calc(100dvh - 88px)}aside{display:flex;flex-direction:column;min-height:0;border-right:1px solid #344139}.maphead{padding:15px 18px;display:flex;align-items:center;justify-content:space-between;font-size:14px}button,a.button{border:1px solid #607066;background:#23352a;color:#fff;padding:8px 12px;border-radius:6px;cursor:pointer;text-decoration:none;font:inherit;font-size:13px}button:hover,a.button:hover{background:#3b5442}button:focus-visible,a:focus-visible{outline:3px solid #f6bd60;outline-offset:3px}#map{flex:1;min-height:200px;background:#19221c}.legend{padding:10px 18px;color:#afbeb3;font-size:12px;line-height:1.6}.gold{color:#ffcb72}.blue{color:#9dcaff}#list{display:flex;gap:7px;padding:10px 18px;overflow:auto;border-top:1px solid #344139}#list button{white-space:nowrap}#list button[aria-pressed=true]{background:#e9bf78;color:#152219}.viewerarea{position:relative;min-width:0;display:flex;flex-direction:column}#viewer{flex:1;min-height:240px}#caption{padding:13px 18px;border-top:1px solid #344139;min-height:85px}#caption strong{display:block;font-size:14px;margin-bottom:7px}#status{font-size:12px;color:#afbeb3;min-height:18px}.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px}.pin{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;border:2px solid #fff;background:#d3973d;color:#111;font:bold 12px system-ui;box-shadow:0 2px 7px #0009}.pin.frame{width:24px;height:24px;background:#477cb3;color:white}.pin.active{outline:4px solid #f8e9b9;outline-offset:3px}.leaflet-tooltip{color:#111}#error{color:#ffd29e}.hint{position:absolute;top:16px;left:18px;background:#122019dd;border:1px solid #82998a;padding:8px 12px;border-radius:6px;font-size:12px;pointer-events:none;z-index:2}details{font-size:12px;color:#aebbb1;padding:0 18px 12px}summary{cursor:pointer}details p{line-height:1.5}@media(max-width:760px){header{height:auto;min-height:86px;padding:12px 16px}header .subtitle{max-width:230px}main{display:flex;flex-direction:column;height:auto}aside{height:44dvh;min-height:340px;border-right:0}#list{padding:8px}.maphead{padding:9px 12px}.legend{padding:5px 12px}.viewerarea{height:65dvh;min-height:440px}details{display:none}h1{font-size:22px}}
</style>
<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.185.1/build/three.module.js","@photo-sphere-viewer/core":"https://cdn.jsdelivr.net/npm/@photo-sphere-viewer/core@5.15.1/index.module.js","@photo-sphere-viewer/dual-fisheye-adapter":"https://cdn.jsdelivr.net/npm/@photo-sphere-viewer/dual-fisheye-adapter@5.15.1/index.module.js"}}</script>
</head><body>
<header><div><div class="eyebrow"><a href="{{ path('drone') }}#inscription-study" style="color:inherit">MemorialAtlas / crop and tentative reading ↗</a></div><h1>St. Peter’s · one row</h1><div class="subtitle">November 13, 2026 · Rappahannock County</div></div><span class="subtitle">2 photos · 5 frames</span></header>
<main><aside><div class="maphead"><strong>Explore the stitched overview</strong><button id="fit">Fit overview</button></div><div id="map" aria-label="Stitched overview with clickable capture centers"></div>
<div class="legend"><span class="gold">● Original stills</span> &nbsp; <span class="blue">● Video frames</span><br>Click a center to open its sphere. Hover to see its footprint.</div><div id="list" aria-label="Choose a capture"></div>
<details><summary>About this overview</summary><p>Five overlapping video frames form this local overview. Two original still photos are independently aligned to it. Points are projected downward-view centers, not GPS positions. Upright stones may show seams or doubled edges; this is a navigation aid, not a surveyed map.</p><p>The sphere uses an approximate dual-fisheye lens projection. Drag to look around; zoom to inspect a stone. <a href="manifest.json">Alignment and source manifest</a></p></details></aside>
<section class="viewerarea" aria-label="360 degree photo viewer"><div class="hint">Drag to look around · scroll to zoom</div><div id="viewer"></div><div id="caption"><strong id="name">Loading captures…</strong><div id="status" role="status"></div><div id="error" role="alert"></div><div class="actions"><button id="prev">← Previous</button><button id="next">Next →</button><a id="source" class="button" target="_blank" rel="noopener">Open source image ↗</a></div></div></section></main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script type="module">
import {Viewer,utils} from '@photo-sphere-viewer/core';
import {DualFisheyeAdapter} from '@photo-sphere-viewer/dual-fisheye-adapter';
class A1Adapter extends DualFisheyeAdapter {
  async loadTexture(panorama){const image=new Image();image.crossOrigin='anonymous';image.src=panorama;await image.decode();return {panorama,texture:utils.createSizedTexture(image)};}
}
A1Adapter.id='a1-row';
const $=id=>document.getElementById(id);
try{
const response=await fetch('{{ asset('drone/st-peter-row/manifest.json') }}');if(!response.ok)throw Error('Could not load capture manifest');const data=await response.json();
const photos=data.photos.sort((a,b)=>{const t=r=>r.kind==='still'?r.filename.split('_')[2]:r.time.replaceAll(':','');return t(a).localeCompare(t(b))});
const initialId=new URL(location.href).searchParams.get('photo');let current=photos.findIndex(p=>p.id===initialId);if(current<0)current=photos.findIndex(p=>p.kind==='still');if(current<0)current=0;
const map=L.map('map',{crs:L.CRS.Simple,minZoom:-4,maxZoom:3,zoomSnap:.1});const bounds=[[0,0],[data.height,data.width]];
L.imageOverlay(data.overview,bounds).addTo(map);map.fitBounds(bounds);$('fit').onclick=()=>map.fitBounds(bounds);
const xy=p=>[data.height-p[1],p[0]];let footprint=null;
const markers=[],buttons=[];
const viewer=new Viewer({container:'viewer',adapter:A1Adapter,panorama:photos[current].panorama,sphereCorrection:{tilt:Math.PI/2,pan:0,roll:0},defaultPitch:-.65,defaultZoomLvl:10,navbar:['zoom','move','fullscreen'],mousewheelCtrlKey:false});
let busy=false;
function label(p,i){return p.kind==='still'?`Photo ${p.filename.split('_')[2].replace(/(..)(..)(..)/,'$1:$2:$3')}`:`Frame ${p.time}`;}
function icon(i){return L.divIcon({className:'',iconSize:photos[i].kind==='still'?[30,30]:[24,24],iconAnchor:photos[i].kind==='still'?[15,15]:[12,12],html:`<span class="pin ${photos[i].kind==='still'?'':'frame'} ${i===current?'active':''}">${i+1}</span>`});}
function update(){const p=photos[current];$('name').textContent=label(p,current);$('source').href=p.sourceImage;$('status').textContent=p.kind==='still'?p.filename:`${p.sourceVideo} · frame at ${p.seconds.toFixed(1)} seconds`;markers.forEach((m,i)=>{m.setIcon(icon(i));m.setZIndexOffset(i===current?1000:photos[i].kind==='still'?500:0)});buttons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===current)));const u=new URL(location.href);u.searchParams.set('photo',p.id);history.replaceState(null,'',u);}
async function select(i){if(busy||i===current)return;busy=true;$('error').textContent='';const old=current;current=i;update();$('status').textContent='Loading sphere…';try{await viewer.setPanorama(photos[i].panorama,{transition:false,showLoader:true});update();}catch(e){current=old;update();$('error').textContent='Could not load this sphere. Try again.';}finally{busy=false;}}
photos.forEach((p,i)=>{const marker=L.marker(xy(p.center),{icon:icon(i),title:label(p,i),keyboard:true}).addTo(map).bindTooltip(label(p,i));marker.on('click',()=>select(i));marker.on('mouseover',()=>{if(footprint)map.removeLayer(footprint);footprint=L.polygon(p.footprint.map(xy),{weight:1,color:'#f6cf8d',fillOpacity:.07,interactive:false}).addTo(map)});marker.on('mouseout',()=>{if(footprint){map.removeLayer(footprint);footprint=null;}});markers.push(marker);const button=document.createElement('button');button.textContent=`${i+1} · ${p.kind==='still'?'Photo':'Frame'}`;button.title=label(p,i);button.onclick=()=>select(i);$('list').append(button);buttons.push(button);});
$('prev').onclick=()=>select((current-1+photos.length)%photos.length);$('next').onclick=()=>select((current+1)%photos.length);update();
new ResizeObserver(()=>map.invalidateSize()).observe($('map'));
}catch(e){$('error').textContent=String(e);$('name').textContent='Explorer unavailable';}
</script></body></html>
