<article class="card">
    <a href="{{ path('item_show', {id:hit.itemId}) }}"><img loading="{{ loop.index <= 3 ? 'eager' : 'lazy' }}" src="{{ hit.thumbnailUrl ?? path('media_file', {id:hit.id}) }}" alt="{{ hit.title }}"></a>
    <div class="body">
        <span class="badge">{{ hit.reviewStatus == 'review' ? 'Ready to review' : hit.reviewStatus }}</span>
        <p class="muted">{{ hit.source }}</p>
        <h3><a href="{{ path('item_show', {id:hit.itemId}) }}">{{ hit.title }}</a></h3>
        {% if hit.cemetery != 'Unassigned' %}<p>{{ hit.cemetery }}</p>{% endif %}
        {% if hit.inscription %}<p class="inscription">{{ hit.inscription|slice(0,200) }}{% if hit.inscription|length > 200 %}…{% endif %}</p>{% endif %}
    </div>
</article>
