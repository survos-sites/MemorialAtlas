<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}MemorialAtlas · A searchable record of remembrance{% endblock %}</title>
{% block resource_hints %}{% endblock %}
{% block javascripts %}{{ importmap('app') }}{% endblock %}
<style>
:root{font-family:system-ui,sans-serif;color:#29362f;background:#f3f0e9}*{box-sizing:border-box}body{margin:0;background:#f3f0e9;color:#29362f}header,main,footer{max-width:1180px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d7d4cb}.brand{font-family:Georgia,serif;font-size:1.6rem;letter-spacing:-.04em}.brand small{display:block;font: .65rem system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#6c776c;margin-top:5px}a{color:#345c49;text-decoration:none}a:hover{text-decoration:underline}nav{display:flex;gap:22px;font-size:.9rem}h1,h2,h3{font-family:Georgia,serif;font-weight:400}h1{font-size:clamp(2.8rem,6vw,5rem);line-height:1.05;letter-spacing:-.05em;margin:18px 0}h2{font-size:2rem;margin-top:38px}h3{font-size:1.4rem}.muted{color:#6c756a}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.7rem;font-weight:600}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}.card{background:#fcfaf5;border:1px solid #d9d9cf;border-radius:5px;overflow:hidden}.card img{width:100%;height:260px;object-fit:contain;background:#e6e6dd}.card .body{padding:20px}.badge{display:inline-block;background:#e1e8dd;border-radius:3px;padding:5px 9px;font-size:.75rem}.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}.gallery img{width:100%;max-height:650px;object-fit:contain}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.78rem}code{background:#e6e7de;padding:3px 5px;overflow-wrap:anywhere}button:not(.btn),.button{display:inline-block;padding:13px 21px;border:0;border-radius:3px;background:#345c49;color:white}p{line-height:1.65}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center;padding:35px 0 48px}.hero p{max-width:550px}.hero figure{margin:0;background:#dddcd1;border-radius:5px;overflow:hidden;position:relative}.hero img{display:block;width:100%;height:auto;object-fit:contain}.hero figcaption{padding:12px 18px;font-size:.75rem;background:#e5e3d9}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;border-top:1px solid #d7d4cb;border-bottom:1px solid #d7d4cb;padding:24px 0}.steps h3{margin:7px 0}.steps p{font-size:.9rem;margin:0}.section-title{display:flex;justify-content:space-between;align-items:baseline}.configured{color:#345c49;font-weight:600}.missing{color:#8c6240}.requirements{list-style:none;padding:0}.requirements li{padding:8px 0}details{margin-top:20px}summary{cursor:pointer}table{width:100%;border-collapse:collapse;font-size:.8rem}th,td{text-align:left;padding:8px 4px;border-bottom:1px solid #e1e3d9}footer{border-top:1px solid #d7d4cb;margin-top:35px;font-size:.8rem;color:#6c756a}.empty{padding:45px;border:1px dashed #b8bfb0}@media(max-width:700px){header,main,footer{padding:18px}.hero{grid-template-columns:1fr;gap:20px;padding-top:20px}.hero img{height:auto}.steps{grid-template-columns:1fr}.gallery{grid-template-columns:1fr}header{flex-wrap:wrap;gap:18px}nav{gap:12px;flex-wrap:wrap}.section-title{display:block}}
.prose{line-height:1.65;overflow-wrap:anywhere}.prose p{margin:0 0 1em}.prose ul,.prose ol{padding-left:1.5em;margin:0 0 1em}.prose li{margin:.35em 0}.prose h1,.prose h2,.prose h3{font-size:1.3rem;letter-spacing:normal;line-height:1.3;margin:1.25em 0 .5em}.prose>:last-child{margin-bottom:0}
.item-overview{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:start}.item-photo{margin:0;background:#e6e6dd;border:1px solid #d9d9cf;border-radius:5px;overflow:hidden}.item-photo img{display:block;width:100%;max-height:740px;object-fit:contain}.item-photo figcaption{padding:12px;font-size:.8rem;overflow-wrap:anywhere}.item-photo-ai{margin-bottom:16px;border-color:#b9a77a}.item-photo-ai img{height:auto}.item-photo-ai .badge{background:#efe3c4;margin-right:4px}.item-description h1{font-size:clamp(2rem,4vw,3.3rem);margin-top:16px}.evidence-stage{margin:14px 0}.evidence-stage h3{margin-top:0}.evidence-table{overflow-x:auto}#ai-history{scroll-margin-top:20px}@media(max-width:700px){.item-overview{grid-template-columns:1fr;gap:20px}}
</style>
</head>
<body><header><a class="brand" href="{{ path('home') }}">MemorialAtlas<small>A searchable record of remembrance</small></a><nav aria-label="Main navigation"><a href="{{ path('item_search') }}">Search</a><a href="/api">API</a><a href="{{ path('about') }}">About</a><a href="{{ path('drone') }}">Drone</a><a href="{{ path('admin') }}">Admin</a>{% if is_granted('ROLE_ADMIN') %}<a href="{{ logout_path() }}">Sign out</a>{% endif %}</nav></header><main>{% block body %}{% endblock %}</main><footer>MemorialAtlas · Built with Symfony · AI proposes. You review. Original photographs remain the evidence.</footer></body>
</html>
