<article class="card"><div class="body">
    <span class="badge">{{ media.position + 1 }} · Audio · {{ media.marking }}</span>
    <h3>{{ media.originalName }}</h3>
    <audio controls preload="metadata" style="width:100%" src="{{ path('media_file', {id:media.id}) }}" aria-label="{{ media.originalName }}"></audio>
    <h3>Transcript</h3><p>{{ media.transcript ?: 'Awaiting transcription.' }}</p>
    {% if media.processingError %}<p role="alert">{{ media.processingError }}</p>{% endif %}
</div></article>
