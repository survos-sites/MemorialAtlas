<article class="card">
    <a href="{{ path('item_show', {id: media.item.id}) }}"><img loading="lazy" src="{{ path('media_file', {id: media.id}) }}" alt="{{ media.originalName }}"></a>
    <div class="body">
        <span class="badge">Image · {{ media.marking }}</span> <span class="badge">Item: {{ media.item.marking }}</span>
        <h3><a href="{{ path('item_show', {id: media.item.id}) }}">{{ media.item.title }}</a></h3>
        {% set summary = media.description ?: media.item.description %}
        <p>{{ summary ? (summary|length > 180 ? summary|slice(0,180) ~ '…' : summary) : 'Awaiting AI description.' }}</p>
    </div>
</article>
