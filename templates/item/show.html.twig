{% extends 'base.html.twig' %}
{% block title %}{{ item.title }} · MemorialAtlas{% endblock %}
{% block resource_hints %}
    {% if photoPreload %}
        <link rel="preconnect" href="{{ memorial_image_origin() }}">
        <link rel="preload" as="image" href="{{ photoPreload }}" fetchpriority="high">
    {% endif %}
{% endblock %}
{% block body %}
{% include '_processing_banner.html.twig' with {pendingCount: item.marking in ['draft','ready','processing','failed'] ? 1 : 0} %}
<p><a href="{{ path('home') }}">← Home</a></p>
{% set images = item.media|filter(m => m.kind == 'image') %}
<section class="item-overview">
    {% if images|length %}{% set photo = images|first %}
        {% set cleaned = memorial_cleaned(photo) %}
        <div>
        {% if cleaned %}{% set view = photo.imageMetadata.cleanedView %}
        <figure class="item-photo item-photo-ai"><img src="{{ cleaned }}" loading="eager" fetchpriority="high" width="{{ view.width }}" height="{{ view.height }}" alt="AI-cleaned view of {{ item.title }}"><figcaption><span class="badge">AI-cleaned view</span> Straightened and relit by {{ view.model }} after Jev judged that the photo was taken at an angle. For display only: an image model can change letters. The original photograph below is the evidence.</figcaption></figure>
        {% endif %}
        <figure class="item-photo"><a href="{{ path('media_file', {id:photo.id}) }}"><img src="{{ memorial_detail(photo) }}" {% if cleaned %}loading="lazy"{% else %}loading="eager" fetchpriority="high"{% endif %} alt="{{ item.title }}"></a><figcaption>Original photograph · {{ photo.originalName }} · <a href="{{ path('media_download', {id:photo.id}) }}">Download full size</a></figcaption></figure>
        </div>
    {% endif %}
    <div class="item-description">
        <span class="badge">{{ item.marking }}</span><h1>{{ item.title }}</h1>
        {% if item.description %}<div class="prose">{{ item.description|markdown_to_html }}</div>{% else %}<p class="muted">No description recorded yet.</p>{% endif %}
        <p class="muted">{{ item.media|length }} media files in capture order. {% if item.marking == 'review' %}Proposed inscription record. Check the photograph before accepting names and dates.{% elseif item.marking == 'draft' %}Not processed yet.{% endif %}</p>
        <a href="#ai-history">See AI evidence and decisions ↓</a>
    </div>
</section>
{% if item.cemetery %}<p><strong>Cemetery (supplied):</strong> <a href="{{ path('cemetery_show', {id:item.cemetery.id}) }}">{{ item.cemetery }}</a></p>{% endif %}
{% if item.locationContext %}<p><strong>Capture context (supplied):</strong> {{ item.locationContext }}</p>{% endif %}
{% if item.processingError %}<p role="alert">Processing failed: {{ item.processingError }}</p>{% endif %}
{% if item.aiResults.catalog is defined %}<details><summary>Extracted inscription and uncertain readings</summary><pre>{{ item.aiResults.catalog.record|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endif %}
{% if item.aiResults.captureGrouping.basis is defined %}<details><summary>Capture grouping · {{ item.media|length }} photographs · proposed</summary><p>{{ item.aiResults.captureGrouping.basis }}</p><p>Grouped by visual review, using capture order, inscriptions and visible details. GPS did not determine identity.</p></details>{% endif %}
{% if item.aiResults.markerFacts is defined %}
<section class="card"><div class="body"><h2>Proposed marker facts</h2>
{% set facts = item.aiResults.markerFacts.record %}
<p>{{ facts.orientation|capitalize }} · {{ facts.form|replace({'_':' '}) }} · {{ facts.people|length }} named people</p>
{% for person in facts.people %}<p><strong>{{ person.name }}</strong>: {{ person.birth ?? '?' }} – {{ person.death ?? 'no death date read' }}{% if not person.commemorated %} (mentioned person){% endif %}
{% for id in person.mediaIds %} <a href="#media-{{ id }}">Photo {{ id }}</a>{% endfor %} {{ person.uncertainty }}</p>{% endfor %}
{% if facts.symbols %}<p>Symbols: {{ facts.symbols|join(', ') }}</p>{% endif %}
{% if facts.epitaph %}<blockquote>{{ facts.epitaph }}</blockquote>{% endif %}
{% for uncertainty in facts.uncertainties %}<p>{{ uncertainty }}</p>{% endfor %}
<details><summary>Extraction evidence and source references</summary><pre>{{ facts|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>
</div></section>{% endif %}
<h2>Source photographs and recordings</h2>
<div class="source-media">{% for media in item.media %}
    {% if media.kind == 'image' %}<article class="card" id="media-{{ media.id }}">
        {% include 'media/_ocr_photo.html.twig' with {media: media} only %}
        <div class="body"><span class="badge">Photo {{ loop.index }}</span>{% if media.marking != 'processed' %} <span class="badge">{{ media.marking == 'failed' ? 'Processing needs retry' : 'Awaiting processing' }}</span>{% endif %}<p>{{ media.originalName }} · <a href="{{ path('media_download', {id:media.id}) }}">Full size</a></p>{% if media.latitude is not null %}<p class="muted">Camera GPS: {{ media.latitude }}, {{ media.longitude }}</p>{% endif %}</div>
    </article>{% else %}{% include 'media/_audio_show.html.twig' with {media:media} only %}{% endif %}
{% endfor %}</div>
<section id="ai-history"><h2>AI evidence history</h2>
<p class="muted">Recorded outputs and decisions, grouped by processing stage. These are claims to review against the photographs, not verified facts. Earlier attempts and timestamps appear only when retained by the provider receipt.</p>
{% for media in images %}
<h3><a href="#media-{{ media.id }}">{{ media.originalName }}</a></h3>
{% if media.ocrText %}
<article class="card evidence-stage"><div class="body"><h3>OCR · inscription transcription</h3><p class="muted">{{ media.aiResults.ocr.provider ?? media.aiResults.ocr.model ?? 'Recorded OCR' }}</p><pre>{{ media.ocrText }}</pre>
{% if media.aiResults.ocr is defined %}<details><summary>Provider receipt</summary><pre>{{ media.aiResults.ocr|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endif %}</div></article>
{% endif %}
{% for key, label in {'jevText':'Jev · text assessment', 'jevImage':'Jev · image assessment', 'jevDecision':'Jev · applied routing decision', 'observe':'Visual description', 'captureReview':'Jev · neighboring capture review'} %}
{% if media.aiResults[key] is defined %}{% set run = media.aiResults[key] %}
<article class="card evidence-stage"><div class="body"><h3>{{ label }}</h3><p class="muted">{{ run.provider ?? '' }} {{ run.model ?? '' }}{% if run.durationMs is defined %} · {{ run.durationMs }} ms{% endif %}</p>
{% if key == 'observe' and media.description %}<div class="prose">{{ media.description|markdown_to_html }}</div>{% endif %}
{% if run.route is defined %}<p>Applied route: <strong>{{ run.route }}</strong></p>{% endif %}
{% if run.answers is defined %}<div class="evidence-table"><table><thead><tr><th>Question</th><th>Answer</th><th>Confidence</th></tr></thead><tbody>{% for question, answer in run.answers %}<tr><td>{{ question|replace({'_':' '}) }}</td><td>{{ answer.choice ?? answer.answer ?? 'See receipt' }}</td><td>{% if answer.confidence is defined %}{{ (answer.confidence * 100)|round }}%{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
<details><summary>Full receipt · inputs, outputs and model metadata</summary><pre>{{ run|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details></div></article>
{% endif %}{% endfor %}
{% endfor %}
{% for key,label in {'catalog':'Catalog · proposed record', 'markerFacts':'Marker facts · structured extraction', 'captureGrouping':'Capture grouping · supplied review'} %}
{% if item.aiResults[key] is defined %}{% set run = item.aiResults[key] %}<article class="card evidence-stage"><div class="body"><h3>{{ label }}</h3><p class="muted">{{ run.provider ?? '' }} {{ run.model ?? '' }}</p><details><summary>Recorded claims and supporting evidence</summary><pre>{{ run|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details></div></article>{% endif %}
{% endfor %}
{% if not item.aiResults and not images|filter(m => m.aiResults or m.ocrText)|length %}<p>No AI processing has been recorded.</p>{% endif %}
</section>
{% endblock %}
