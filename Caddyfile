{
    auto_https off
    frankenphp
}

:{$PORT:5000} {
    root * /app/public
    header {
        X-Frame-Options SAMEORIGIN
        X-Content-Type-Options nosniff
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    request_body {
        max_size 32MB
    }
    @private path */.*
    respond @private 404
    php_server
}
