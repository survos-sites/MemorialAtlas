{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-pdo_pgsql": "*",
        "ext-pdo_sqlite": "*",
        "api-platform/doctrine-orm": "^5.0",
        "api-platform/symfony": "^5.0",
        "async-aws/s3": "^3.5",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "easycorp/easyadmin-bundle": "^5.0@beta",
        "league/commonmark": "^2.10",
        "nelmio/cors-bundle": "^2.6",
        "survos/cloudflared-bundle": "^2.41",
        "survos/elastic-bundle": "^2.43",
        "survos/field-bundle": "^2.45",
        "survos/imagor-bundle": "^2.5",
        "survos/search-bundle": "^2.45",
        "symfony/ai-bundle": "^1.0.0-beta1",
        "symfony/ai-gemini-platform": "^1.0.0-beta1",
        "symfony/ai-mistral-platform": "^1.0.0-beta1",
        "symfony/ai-ollama-platform": "^1.0.0-beta1",
        "symfony/ai-open-ai-platform": "^1.0.0-beta1",
        "symfony/ai-type-safe-platform": "^1.0.0-beta1",
        "symfony/asset-mapper": "^8.2",
        "symfony/console": "^8.2@beta",
        "symfony/doctrine-messenger": "^8.2",
        "symfony/dotenv": "^8.2@beta",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "^8.2@beta",
        "symfony/mcp-bundle": "^1.0.0-beta1",
        "symfony/messenger": "^8.2",
        "symfony/runtime": "^8.2@beta",
        "symfony/security-csrf": "^8.2@beta",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/twig-bundle": "^8.2@beta",
        "symfony/ux-image": "^3.7",
        "symfony/ux-imagor-image": "^3.7",
        "symfony/validator": "^8.2@beta",
        "symfony/workflow": "^8.2@beta",
        "symfony/yaml": "^8.2@beta",
        "twig/markdown-extra": "^3.29"
    },
    "require-dev": {
        "symfony/browser-kit": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/stopwatch": "^8.2",
        "symfony/web-profiler-bundle": "^8.2"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": false,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@php bin/apply-mistral-ocr-fix.php",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@php bin/apply-mistral-ocr-fix.php",
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.2"
        }
    },
    "name": "survos/scanfony",
    "description": "Photographs and spoken context into evidence-backed catalog records with Symfony AI"
}
