DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
# Symfony CLI overrides this URL from the running Compose database.
# Generate your own application secret for anything beyond local development.
APP_SECRET=change-me
S3_ENDPOINT=https://your-s3-endpoint
AWS_S3_BUCKET_NAME=your-existing-bucket
AWS_S3_ACCESS_ID=
AWS_S3_ACCESS_SECRET=
IMAGOR_HOST=https://your-imagor-service
IMAGOR_SECRET=
OLLAMA_ENDPOINT=http://127.0.0.1:11434
MISTRAL_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
SCANFONY_VISION_PLATFORM=mistral
SCANFONY_VISION_MODEL=mistral-medium-latest
SCANFONY_OCR_MODEL=mistral-ocr-latest
SCANFONY_OCR_ENABLED=1

# Hosted typed decisions, with optional experimental image escalation.
TYPESAFE_API_KEY=
SCANFONY_JEV_MODEL=jev-1.14.0
SCANFONY_META_OCR=1
# Set 1 for flowers, veteran accessories, clothing, and other visual context.
SCANFONY_REQUIRE_VISUAL_CONTEXT=0

# Admin username: admin. Set a password hash in .env.local; empty disables sign-in.
ADMIN_PASSWORD_HASH=

ELASTICSEARCH_DSN=elasticsearch://127.0.0.1:9200
